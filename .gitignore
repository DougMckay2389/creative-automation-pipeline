# Credentials. .env is the only place a real key should ever live, and it
# never leaves this machine.
.env
*.key
keys.txt

# Wrangler's OAuth transcript. It holds no token -- only the authorization
# REQUEST url -- but an account id and a scope list are nobody's business.
wrangler-login.log

# Run artifacts. output/ is regenerated by any run; .cache/ is the
# content-addressed master cache, and shipping it would mean a reviewer's
# "first run" silently skipped the generative call the README promises.
output/
.cache/
_to_delete/

__pycache__/
*.pyc
.venv/
venv/
.DS_Store
