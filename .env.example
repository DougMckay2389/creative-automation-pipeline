# Copy to .env and fill in whichever provider you want to use.
# .env is gitignored. Never commit real values.

# --- Cloudflare Workers AI -------------------------------------------------
# Account ID: Cloudflare dashboard -> Workers & Pages -> right-hand sidebar.
# API token:  My Profile -> API Tokens -> Create Token -> Custom token,
#             permission "Account · Workers AI · Read".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# optional, defaults to @cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- Google Gemini ---------------------------------------------------------
GEMINI_API_KEY=

# --- Adobe Firefly Services ------------------------------------------------
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=
# FIREFLY_CUSTOM_MODEL_ID=urn:aaid:sc:...
